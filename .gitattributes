# Normalize line endings: Git stores LF, checks out native on Windows.
* text=auto eol=lf

# Scripts must stay LF even on Windows checkouts.
*.sh text eol=lf

# Binary assets — never normalize or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Keep generated/vendored files from skewing language stats and diffs.
package-lock.json linguist-generated=true -diff
docs/** linguist-documentation
branding/** linguist-vendored
