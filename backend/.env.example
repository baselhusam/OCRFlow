DATABASE_URL=postgresql+asyncpg://ocrflow:ocrflow_dev@localhost:5432/ocrflow
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Admin bootstrap (promotes/creates admin on startup)
ADMIN_EMAIL=baselmathar@gmail.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Basel Mathar

# Model inference
# cpu | cuda | rocm | mps | mlx | auto
OCRFLOW_MODEL_CACHE=~/.cache/ocrflow
OCRFLOW_DEFAULT_DEVICE=cpu
OCRFLOW_INFERENCE_TIMEOUT=120
OCRFLOW_DOCUMENT_CONVERSION_TIMEOUT=600
OCRFLOW_MAX_IMAGE_DIMENSION=4096
# Local text/vision runtime. Pull qwen3:0.6b and qwen3.5:0.8b.
OCRFLOW_OLLAMA_BASE_URL=http://127.0.0.1:11434
OCRFLOW_LIQUID_SERVICE_URL=http://127.0.0.1:8104

# Runner mode for host `uvicorn`:
#   local  — in-process (tests / single-venv). OCR extras optional; runtime probes imports.
#   remote — gateway only; start OCR with `make be-ocr-*` or `make ocr-*` (recommended).
# For remote host hybrid, copy values from `.env.remote.example`.
OCRFLOW_RUNNER_MODE=local
