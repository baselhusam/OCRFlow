# Host gateway + optional OCR microservices (hybrid local development).
# Copy these into backend/.env when using OCRFLOW_RUNNER_MODE=remote with
# make be-ocr-surya / be-ocr-docling / be-ocr-paddle (or Docker ocr-* targets).

OCRFLOW_RUNNER_MODE=remote
OCRFLOW_SURYA_SERVICE_URL=http://127.0.0.1:8101
OCRFLOW_DOCLING_SERVICE_URL=http://127.0.0.1:8102
OCRFLOW_PADDLE_SERVICE_URL=http://127.0.0.1:8103
OCRFLOW_OLLAMA_BASE_URL=http://127.0.0.1:11434
OCRFLOW_RUNTIME_HEALTH_TIMEOUT=2
