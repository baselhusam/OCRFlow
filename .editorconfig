# EditorConfig — https://editorconfig.org
# Consistent whitespace across the polyglot repo (Python + TS/JS + YAML).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python: PEP 8 four-space indentation.
[*.py]
indent_size = 4

# Makefiles require real tabs.
[Makefile]
indent_style = tab

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_size = 2
